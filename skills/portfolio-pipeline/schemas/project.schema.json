{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-pipeline/project.schema.json",
  "title": "Portfolio Project",
  "description": "Canonical machine-readable representation of a portfolio case study. Version 1.",
  "type": "object",
  "required": ["schemaVersion", "language", "project", "summary", "stack", "features", "differentiators", "screenshots", "verification", "publication"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": ["string", "null"] },
    "updatedAt": { "type": ["string", "null"] },
    "language": { "type": "string", "default": "it" },
    "project": {
      "type": "object",
      "required": ["name", "slug", "status", "urls"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "slug": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "client": { "type": ["string", "null"] },
        "industry": { "type": "array", "items": { "type": "string" } },
        "productType": {
          "type": "object",
          "properties": {
            "primary": { "type": ["string", "null"] },
            "secondary": { "type": "array", "items": { "type": "string" } }
          }
        },
        "targetUsers": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["live", "demo", "development", "archived", "unknown"] },
        "year": { "type": ["integer", "null"] },
        "timeline": { "type": ["string", "null"] },
        "role": { "type": "array", "items": { "type": "string" } },
        "urls": {
          "type": "object",
          "properties": {
            "live": { "type": ["string", "null"] },
            "demo": { "type": ["string", "null"] },
            "repository": { "type": ["string", "null"] }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "oneLine": { "type": ["string", "null"] },
        "card": { "type": ["string", "null"] },
        "hero": { "type": ["string", "null"] },
        "overview": { "type": ["string", "null"] }
      }
    },
    "stack": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "items"],
        "properties": {
          "category": { "enum": ["frontend", "backend", "data", "infrastructure", "integrations", "tooling"] },
          "items": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "implementationStatus"],
        "properties": {
          "name": { "type": "string" },
          "what": { "type": ["string", "null"] },
          "why": { "type": ["string", "null"] },
          "value": { "enum": ["HIGH", "MEDIUM", "LOW"] },
          "implementationStatus": { "enum": ["implemented", "partial", "configured", "planned", "legacy-unused", "documented-unverified"] },
          "evidence": { "type": "array", "items": { "type": "string", "pattern": "^E[0-9]{3,}$" } }
        }
      }
    },
    "differentiators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string" },
          "what": { "type": ["string", "null"] },
          "technicalInterest": { "type": ["string", "null"] },
          "businessValue": { "type": ["string", "null"] },
          "evidence": { "type": "array", "items": { "type": "string", "pattern": "^E[0-9]{3,}$" } }
        }
      }
    },
    "engineeringHighlights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string" },
          "challenge": { "type": ["string", "null"] },
          "solution": { "type": ["string", "null"] },
          "technology": { "type": ["string", "null"] },
          "evidence": { "type": "array", "items": { "type": "string", "pattern": "^E[0-9]{3,}$" } }
        }
      }
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["filename", "priority", "status"],
        "properties": {
          "filename": { "type": "string" },
          "screen": { "type": ["string", "null"] },
          "route": { "type": ["string", "null"] },
          "viewport": { "type": ["string", "null"] },
          "priority": { "enum": ["HERO", "HIGH", "MEDIUM"] },
          "purpose": { "type": ["string", "null"] },
          "evidence": { "type": "array", "items": { "type": "string", "pattern": "^E[0-9]{3,}$" } },
          "status": { "enum": ["captured", "planned", "unavailable"] }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 10 },
    "verification": {
      "type": "object",
      "required": ["runtimeVerified", "reviewed", "approvedForPublish"],
      "properties": {
        "runtimeVerified": { "type": "boolean" },
        "reviewed": { "type": "boolean" },
        "approvedForPublish": { "type": "boolean" },
        "evidenceCount": { "type": "integer", "minimum": 0 },
        "confirmedEvidenceCount": { "type": "integer", "minimum": 0 },
        "unverifiedClaims": { "type": "array", "items": { "type": "string" } }
      }
    },
    "missingInformation": { "type": "array", "items": { "type": "string" } },
    "publication": {
      "type": "object",
      "required": ["published"],
      "properties": {
        "published": { "type": "boolean" },
        "target": { "type": ["string", "null"] },
        "publishedAt": { "type": ["string", "null"] }
      }
    }
  }
}
